NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
DATABASE_URL=postgresql://postgrs:root@localhost:5433/hr_system?schema=public

JWT_SECRET=development-access-secret-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development-refresh-secret-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=payroll@localhost

BCRYPT_ROUNDS=12
COMPANY_ID_HEADER=x-company-id
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
