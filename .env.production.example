NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=v1

POSTGRES_USER=hr_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=hr_system
DATABASE_URL=postgresql://hr_user:replace-with-a-strong-password@postgres:5432/hr_system?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=payroll@example.com

BCRYPT_ROUNDS=12
COMPANY_ID_HEADER=x-company-id
CORS_ORIGINS=https://your-domain.example
