model Company {
  id             String        @id @default(uuid())
  name           String
  registrationNo String?       @unique
  taxNo          String?
  address        String?
  phone          String?
  email          String?
  logoUrl        String?
  status         CompanyStatus @default(TRIAL)
  timezone       String        @default("Asia/Colombo")
  currency       String        @default("LKR")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users              User[]
  employees          Employee[]
  departments        Department[]
  employeeDocuments  EmployeeDocument[]
  probationReviews   ProbationReview[]
  separationRequests SeparationRequest[]
  salaryComponents   SalaryComponent[]
  salaryProfiles     SalaryProfile[]
  compensationGrades CompensationGrade[]
  compensationBands  CompensationBand[]
  incrementPlans     AnnualIncrementPlan[]
  variablePayAwards  VariablePayAward[]
  allowanceRecords   AllowanceRecord[]
  benefitPlans       BenefitPlan[]
  benefitEnrollments BenefitEnrollment[]
  payRuns            PayRun[]
  payslips           Payslip[]
  complianceRules    PayrollComplianceRule[]
  bankExportFormats  BankExportFormat[]
  statutoryFilings   StatutoryFiling[]
  gratuityAccruals   GratuityAccrual[]
  attendancePolicies AttendancePolicy[]
  shiftTemplates     ShiftTemplate[]
  shiftAssignments   ShiftAssignment[]
  attendanceRecords  AttendanceRecord[]
  attendancePunches  AttendancePunch[]
  biometricDevices   BiometricDevice[]
  qrCheckInSessions  QrCheckInSession[]
  attendanceAlerts   AttendanceAlert[]
  leaveTypes         LeaveType[]
  leavePolicies      LeavePolicy[]
  leaveBalances      LeaveBalance[]
  leaveLedgerEntries LeaveLedgerEntry[]
  leaveApplications  LeaveApplication[]
  leaveApprovalSteps LeaveApprovalStep[]
  holidayCalendars   HolidayCalendar[]
  publicHolidays     PublicHoliday[]
  leaveEncashments   LeaveEncashment[]
  auditLogs          AuditLog[]

  // Recruitment & Onboarding relations
  jobRequisitions                JobRequisition[]
  jobPostings                    JobPosting[]
  candidates                     Candidate[]
  candidateApplications          CandidateApplication[]
  candidateDocuments             CandidateDocument[]
  candidateNotes                 CandidateNote[]
  interviews                     Interview[]
  interviewFeedbacks             InterviewFeedback[]
  offerLetters                   OfferLetter[]
  offerLetterTemplates           OfferLetterTemplate[]
  signatureRequests              SignatureRequest[]
  onboardingChecklists           OnboardingChecklist[]
  onboardingTasks                OnboardingTask[]
  onboardingInstances            OnboardingInstance[]
  onboardingTaskInstances        OnboardingTaskInstance[]
  documentRequests               DocumentRequest[]
  performanceCycles              PerformanceCycle[]
  performanceGoals               PerformanceGoal[]
  performanceCheckIns            PerformanceCheckIn[]
  feedbackRequests               FeedbackRequest[]
  performanceReviews             PerformanceReview[]
  calibrationSessions            CalibrationSession[]
  calibrationItems               CalibrationItem[]
  salaryIncrementRecommendations SalaryIncrementRecommendation[]
  performanceImprovementPlans    PerformanceImprovementPlan[]

  @@map("companies")
}

model User {
  id                     String     @id @default(uuid())
  companyId              String
  email                  String
  passwordHash           String
  role                   UserRole   @default(EMPLOYEE)
  status                 UserStatus @default(PENDING_VERIFICATION)
  firstName              String
  lastName               String
  phone                  String?
  avatarUrl              String?
  lastLoginAt            DateTime?
  dataProcessingConsent  Boolean    @default(false)
  consentGivenAt         DateTime?
  refreshTokenHash       String?
  emailVerificationToken String?
  emailVerifiedAt        DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  company                    Company             @relation(fields: [companyId], references: [id])
  employee                   Employee?
  auditLogs                  AuditLog[]
  uploadedEmployeeDocuments  EmployeeDocument[]  @relation("EmployeeDocumentUploader")
  probationReviews           ProbationReview[]   @relation("ProbationReviewer")
  requestedSeparations       SeparationRequest[] @relation("SeparationRequester")
  approvedSeparations        SeparationRequest[] @relation("SeparationApprover")
  approvedAttendanceRecords  AttendanceRecord[]  @relation("AttendanceApprover")
  editedAttendanceRecords    AttendanceRecord[]  @relation("AttendanceEditor")
  attendanceAlerts           AttendanceAlert[]   @relation("AttendanceAlertAssignee")
  requestedLeaveApplications LeaveApplication[]  @relation("LeaveRequester")
  approvedLeaveApplications  LeaveApplication[]  @relation("LeaveApprover")
  leaveApprovalSteps         LeaveApprovalStep[] @relation("LeaveApprovalActor")
  approvedLeaveEncashments   LeaveEncashment[]   @relation("LeaveEncashmentApprover")

  // Recruitment & Onboarding relations
  requisitionApprovals           RequisitionApproval[]           @relation("RequisitionApprover")
  interviewFeedbacks             InterviewFeedback[]             @relation("InterviewFeedbackAuthor")
  candidateNotes                 CandidateNote[]                 @relation("CandidateNoteAuthor")
  scheduledInterviews            Interview[]                     @relation("InterviewScheduler")
  interviewerAssignments         Interview[]                     @relation("Interviewer")
  approvedOffers                 OfferLetter[]                   @relation("OfferApprover")
  createdOffers                  OfferLetter[]                   @relation("OfferCreator")
  createdPerformanceCycles       PerformanceCycle[]              @relation("PerformanceCycleCreator")
  createdPerformanceGoals        PerformanceGoal[]               @relation("PerformanceGoalCreator")
  managedPerformanceCheckIns     PerformanceCheckIn[]            @relation("PerformanceCheckInManager")
  requestedFeedbacks             FeedbackRequest[]               @relation("FeedbackRequester")
  feedbackResponses              FeedbackRequest[]               @relation("FeedbackReviewer")
  managedPerformanceReviews      PerformanceReview[]             @relation("PerformanceReviewManager")
  facilitatedCalibrationSessions CalibrationSession[]            @relation("CalibrationFacilitator")
  approvedSalaryIncrements       SalaryIncrementRecommendation[] @relation("SalaryIncrementApprover")
  managedPips                    PerformanceImprovementPlan[]    @relation("PipManager")

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Department {
  id                 String    @id @default(uuid())
  companyId          String
  parentDepartmentId String?
  managerEmployeeId  String?
  name               String
  code               String?
  description        String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  parent           Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  children         Department[]      @relation("DepartmentHierarchy")
  manager          Employee?         @relation("DepartmentManager", fields: [managerEmployeeId], references: [id])
  employees        Employee[]        @relation("EmployeeDepartment")
  jobRequisitions  JobRequisition[]
  performanceGoals PerformanceGoal[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentDepartmentId])
  @@index([managerEmployeeId])
  @@map("departments")
}

model Employee {
  id                  String             @id @default(uuid())
  companyId           String
  userId              String?            @unique
  departmentId        String?
  reportingManagerId  String?
  employeeNo          String?
  firstName           String
  lastName            String
  preferredName       String?
  workEmail           String?
  personalEmail       String?
  phone               String?
  address             String?
  nicNumber           String?
  passportNumber      String?
  dateOfBirth         DateTime?
  jobTitle            String?
  employmentType      EmploymentType     @default(PERMANENT)
  status              EmployeeStatus     @default(ON_PROBATION)
  joinedAt            DateTime
  probationStartDate  DateTime?
  probationEndDate    DateTime?
  probationStatus     ProbationStatus    @default(IN_PROGRESS)
  confirmedAt         DateTime?
  separatedAt         DateTime?
  terminatedAt        DateTime?
  epfNumber           String?
  payrollActive       Boolean            @default(true)
  bankName            String?
  bankCode            String?
  bankBranchCode      String?
  bankAccountNo       String?
  bankAccountName     String?
  taxDeclarationType  TaxDeclarationType @default(PRIMARY)
  isPrimaryEmployment Boolean            @default(true)
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  company              Company                   @relation(fields: [companyId], references: [id])
  user                 User?                     @relation(fields: [userId], references: [id])
  department           Department?               @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  reportingManager     Employee?                 @relation("EmployeeReporting", fields: [reportingManagerId], references: [id])
  directReports        Employee[]                @relation("EmployeeReporting")
  managedDepartments   Department[]              @relation("DepartmentManager")
  documents            EmployeeDocument[]
  probationReviews     ProbationReview[]
  separationRequests   SeparationRequest[]
  salaryProfile        SalaryProfile?
  annualIncrementItems AnnualIncrementPlanItem[]
  variablePayAwards    VariablePayAward[]
  allowanceRecords     AllowanceRecord[]
  benefitEnrollments   BenefitEnrollment[]
  payRunEmployees      PayRunEmployee[]
  payslips             Payslip[]
  gratuityAccruals     GratuityAccrual[]
  shiftAssignments     ShiftAssignment[]
  attendanceRecords    AttendanceRecord[]
  attendancePunches    AttendancePunch[]
  attendanceAlerts     AttendanceAlert[]
  leaveBalances        LeaveBalance[]
  leaveLedgerEntries   LeaveLedgerEntry[]
  leaveApplications    LeaveApplication[]
  leaveEncashments     LeaveEncashment[]

  // Recruitment & Onboarding relations
  requisitionsAsManager          JobRequisition[]                @relation("RequisitionHiringManager")
  onboardingInstance             OnboardingInstance?             @relation("OnboardedEmployee")
  referredCandidates             Candidate[]                     @relation("CandidateReferrer")
  performanceGoals               PerformanceGoal[]               @relation("PerformanceGoalOwner")
  performanceCheckIns            PerformanceCheckIn[]
  feedbackSubjects               FeedbackRequest[]               @relation("FeedbackSubject")
  performanceReviews             PerformanceReview[]
  salaryIncrementRecommendations SalaryIncrementRecommendation[]
  performanceImprovementPlans    PerformanceImprovementPlan[]

  @@unique([companyId, employeeNo])
  @@unique([companyId, nicNumber])
  @@unique([companyId, passportNumber])
  @@unique([companyId, epfNumber])
  @@index([companyId])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@index([employmentType])
  @@index([status])
  @@index([probationEndDate])
  @@map("employees")
}

model EmployeeDocument {
  id               String                 @id @default(uuid())
  companyId        String
  employeeId       String
  uploadedByUserId String
  type             EmployeeDocumentType
  status           EmployeeDocumentStatus @default(PENDING_UPLOAD)
  fileName         String
  mimeType         String
  sizeBytes        Int?
  checksum         String?
  bucket           String
  objectKey        String
  uploadedAt       DateTime?
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  company    Company  @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
  uploadedBy User     @relation("EmployeeDocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([type])
  @@index([status])
  @@map("employee_documents")
}

model ProbationReview {
  id               String                 @id @default(uuid())
  companyId        String
  employeeId       String
  reviewedByUserId String
  outcome          ProbationReviewOutcome
  notes            String?
  reviewDate       DateTime               @default(now())
  nextReviewDate   DateTime?
  createdAt        DateTime               @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
  reviewedBy User     @relation("ProbationReviewer", fields: [reviewedByUserId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([reviewDate])
  @@map("probation_reviews")
}

model SeparationRequest {
  id                String           @id @default(uuid())
  companyId         String
  employeeId        String
  requestedByUserId String
  approvedByUserId  String?
  type              SeparationType
  status            SeparationStatus @default(REQUESTED)
  reason            String
  effectiveDate     DateTime
  notes             String?
  approvedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id])
  requestedBy User     @relation("SeparationRequester", fields: [requestedByUserId], references: [id])
  approvedBy  User?    @relation("SeparationApprover", fields: [approvedByUserId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([effectiveDate])
  @@map("separation_requests")
}

model SalaryComponent {
  id               String              @id @default(uuid())
  companyId        String
  name             String
  code             String
  type             SalaryComponentType
  defaultAmount    Decimal             @default(0) @db.Decimal(14, 2)
  taxable          Boolean             @default(true)
  epfEligible      Boolean             @default(false)
  etfEligible      Boolean             @default(false)
  apitEligible     Boolean             @default(true)
  visibleOnPayslip Boolean             @default(true)
  isSystem         Boolean             @default(false)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company            Company                   @relation(fields: [companyId], references: [id])
  employeeComponents EmployeeSalaryComponent[]
  payrollLineItems   PayrollLineItem[]
  variablePayAwards  VariablePayAward[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type])
  @@map("salary_components")
}

model SalaryProfile {
  id                         String               @id @default(uuid())
  companyId                  String
  employeeId                 String               @unique
  compensationGradeId        String?
  compensationBandId         String?
  basicSalary                Decimal              @db.Decimal(14, 2)
  standardHoursPerMonth      Decimal              @default(240) @db.Decimal(8, 2)
  paymentMethod              PayrollPaymentMethod @default(BANK_TRANSFER)
  bankName                   String?
  bankCode                   String?
  bankBranchCode             String?
  bankAccountNo              String?
  bankAccountName            String?
  epfNumber                  String?
  taxDeclarationType         TaxDeclarationType   @default(PRIMARY)
  isPrimaryEmployment        Boolean              @default(true)
  epfEnabled                 Boolean              @default(true)
  etfEnabled                 Boolean              @default(true)
  apitEnabled                Boolean              @default(true)
  overtimeEnabled            Boolean              @default(true)
  establishmentEmployeeCount Int?
  effectiveFrom              DateTime
  effectiveTo                DateTime?
  isActive                   Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  company                        Company                         @relation(fields: [companyId], references: [id])
  employee                       Employee                        @relation(fields: [employeeId], references: [id])
  compensationGrade              CompensationGrade?              @relation(fields: [compensationGradeId], references: [id])
  compensationBand               CompensationBand?               @relation(fields: [compensationBandId], references: [id])
  components                     EmployeeSalaryComponent[]
  payRunEmployees                PayRunEmployee[]
  annualIncrementPlanItems       AnnualIncrementPlanItem[]
  salaryIncrementRecommendations SalaryIncrementRecommendation[]

  @@index([companyId])
  @@index([employeeId])
  @@index([compensationGradeId])
  @@index([compensationBandId])
  @@index([isActive])
  @@map("salary_profiles")
}

model EmployeeSalaryComponent {
  id                 String              @id @default(uuid())
  salaryProfileId    String
  componentId        String
  amount             Decimal             @db.Decimal(14, 2)
  quantity           Decimal             @default(1) @db.Decimal(10, 2)
  overtimeMultiplier OvertimeMultiplier?
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  salaryProfile SalaryProfile   @relation(fields: [salaryProfileId], references: [id])
  component     SalaryComponent @relation(fields: [componentId], references: [id])

  @@index([salaryProfileId])
  @@index([componentId])
  @@map("employee_salary_components")
}

model CompensationGrade {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company            @relation(fields: [companyId], references: [id])
  bands          CompensationBand[]
  salaryProfiles SalaryProfile[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@map("compensation_grades")
}

model CompensationBand {
  id          String   @id @default(uuid())
  companyId   String
  gradeId     String
  code        String
  name        String
  minSalary   Decimal  @db.Decimal(14, 2)
  midpoint    Decimal? @db.Decimal(14, 2)
  maxSalary   Decimal  @db.Decimal(14, 2)
  currency    String   @default("LKR")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id])
  grade          CompensationGrade @relation(fields: [gradeId], references: [id])
  salaryProfiles SalaryProfile[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([gradeId])
  @@index([isActive])
  @@map("compensation_bands")
}

model AnnualIncrementPlan {
  id                   String                 @id @default(uuid())
  companyId            String
  name                 String
