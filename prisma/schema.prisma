  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company          Company                  @relation(fields: [companyId], references: [id])
  checklist        OnboardingChecklist      @relation(fields: [checklistId], references: [id])
  employee         Employee                 @relation("OnboardedEmployee", fields: [employeeId], references: [id])
  taskInstances    OnboardingTaskInstance[]
  documentRequests DocumentRequest[]

  @@index([companyId])
  @@index([checklistId])
  @@index([employeeId])
  @@index([status])
  @@map("onboarding_instances")
}

model OnboardingTaskInstance {
  id                   String               @id @default(uuid())
  companyId            String
  onboardingInstanceId String
  taskId               String
  status               OnboardingTaskStatus @default(PENDING)
  completedAt          DateTime?
  skippedAt            DateTime?
  evidence             String?
  notes                String?
  dueDate              DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  company            Company            @relation(fields: [companyId], references: [id])
  onboardingInstance OnboardingInstance @relation(fields: [onboardingInstanceId], references: [id])
  task               OnboardingTask     @relation(fields: [taskId], references: [id])

  @@unique([onboardingInstanceId, taskId])
  @@index([companyId])
  @@index([onboardingInstanceId])
  @@index([taskId])
  @@index([status])
  @@map("onboarding_task_instances")
}

model DocumentRequest {
  id                   String                @id @default(uuid())
  companyId            String
  onboardingInstanceId String
  title                String
  description          String?
  documentType         String                @default("OTHER")
  required             Boolean               @default(true)
  status               DocumentRequestStatus @default(PENDING)
  dueDate              DateTime?
  fileName             String?
  mimeType             String?
  sizeBytes            Int?
  bucket               String?
  objectKey            String?
  uploadedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  company            Company            @relation(fields: [companyId], references: [id])
  onboardingInstance OnboardingInstance @relation(fields: [onboardingInstanceId], references: [id])

  @@index([companyId])
  @@index([onboardingInstanceId])
  @@index([status])
  @@map("document_requests")
}
